<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:mobility="http://example.org/mobility-ontology/2025/09#"
         xml:base="http://example.org/mobility-ontology/2025/09#">

    <owl:Ontology rdf:about="http://example.org/mobility-ontology/2025/09">
        <rdfs:label xml:lang="fr">Ontologie de Mobilité Urbaine Intelligente</rdfs:label>
        <rdfs:comment xml:lang="fr">Une ontologie pour modéliser les systèmes de mobilité urbaine intelligente</rdfs:comment>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="#Utilisateur">
        <rdfs:label xml:lang="fr">Utilisateur</rdfs:label>
        <rdfs:comment xml:lang="fr">Personne qui utilise les services de mobilité</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Trajet">
        <rdfs:label xml:lang="fr">Trajet</rdfs:label>
        <rdfs:comment xml:lang="fr">Parcours effectué d'un point A vers un point B</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Véhicule">
        <rdfs:label xml:lang="fr">Véhicule</rdfs:label>
        <rdfs:comment xml:lang="fr">Moyen de transport</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Station">
        <rdfs:label xml:lang="fr">Station</rdfs:label>
        <rdfs:comment xml:lang="fr">Point d'arrêt ou de stationnement</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#TransportPublic">
        <rdfs:label xml:lang="fr">Transport Public</rdfs:label>
        <rdfs:comment xml:lang="fr">Service de transport collectif</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Arrêt">
        <rdfs:label xml:lang="fr">Arrêt</rdfs:label>
        <rdfs:comment xml:lang="fr">Point d'arrêt du transport public</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#PisteCyclable">
        <rdfs:label xml:lang="fr">Piste Cyclable</rdfs:label>
        <rdfs:comment xml:lang="fr">Infrastructure dédiée aux cyclistes</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Vélo">
        <rdfs:label xml:lang="fr">Vélo</rdfs:label>
        <rdfs:comment xml:lang="fr">Véhicule à deux roues actionné par pédales</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Véhicule"/>
    </owl:Class>
    
    <owl:Class rdf:about="#Voiture">
        <rdfs:label xml:lang="fr">Voiture</rdfs:label>
        <rdfs:comment xml:lang="fr">Véhicule automobile à quatre roues</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Véhicule"/>
    </owl:Class>
    
    <owl:Class rdf:about="#Réservation">
        <rdfs:label xml:lang="fr">Réservation</rdfs:label>
        <rdfs:comment xml:lang="fr">Réservation d'un véhicule ou service de transport</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Route">
        <rdfs:label xml:lang="fr">Route</rdfs:label>
        <rdfs:comment xml:lang="fr">Itinéraire ou chemin entre deux points</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Administrateur">
        <rdfs:label xml:lang="fr">Administrateur</rdfs:label>
        <rdfs:comment xml:lang="fr">Gestionnaire de la plateforme de mobilité</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Utilisateur"/>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#planifie">
        <rdfs:label xml:lang="fr">planifie</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un utilisateur et un trajet qu'il planifie</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="#Trajet"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#effectuéPar">
        <rdfs:label xml:lang="fr">effectué par</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un trajet et l'utilisateur qui l'effectue</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="#Utilisateur"/>
        <owl:inverseOf rdf:resource="#planifie"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#utilise">
        <rdfs:label xml:lang="fr">utilise</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un utilisateur et un véhicule qu'il utilise</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="#Véhicule"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#réserve">
        <rdfs:label xml:lang="fr">réserve</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un utilisateur et une réservation qu'il effectue</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="#Réservation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#concerne">
        <rdfs:label xml:lang="fr">concerne</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre une réservation et le véhicule concerné</rdfs:comment>
        <rdfs:domain rdf:resource="#Réservation"/>
        <rdfs:range rdf:resource="#Véhicule"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#disponibleÀ">
        <rdfs:label xml:lang="fr">disponible à</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un vélo et la station où il est disponible</rdfs:comment>
        <rdfs:domain rdf:resource="#Vélo"/>
        <rdfs:range rdf:resource="#Station"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#garéeÀ">
        <rdfs:label xml:lang="fr">garée à</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre une voiture et la station où elle est garée</rdfs:comment>
        <rdfs:domain rdf:resource="#Voiture"/>
        <rdfs:range rdf:resource="#Station"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#dessert">
        <rdfs:label xml:lang="fr">dessert</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un transport public et les arrêts qu'il dessert</rdfs:comment>
        <rdfs:domain rdf:resource="#TransportPublic"/>
        <rdfs:range rdf:resource="#Arrêt"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#passeParStation">
        <rdfs:label xml:lang="fr">passe par station</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre une route et les stations qu'elle traverse</rdfs:comment>
        <rdfs:domain rdf:resource="#Route"/>
        <rdfs:range rdf:resource="#Station"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#suitRoute">
        <rdfs:label xml:lang="fr">suit route</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un trajet et la route qu'il suit</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="#Route"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#gère">
        <rdfs:label xml:lang="fr">gère</rdfs:label>
        <rdfs:comment xml:lang="fr">Relation entre un administrateur et les entités qu'il gère</rdfs:comment>
        <rdfs:domain rdf:resource="#Administrateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    
    <!-- Propriétés pour Utilisateur -->
    <owl:DatatypeProperty rdf:about="#nom">
        <rdfs:label xml:lang="fr">nom</rdfs:label>
        <rdfs:comment xml:lang="fr">Nom de l'utilisateur</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#email">
        <rdfs:label xml:lang="fr">email</rdfs:label>
        <rdfs:comment xml:lang="fr">Adresse email de l'utilisateur</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#typeUtilisateur">
        <rdfs:label xml:lang="fr">type d'utilisateur</rdfs:label>
        <rdfs:comment xml:lang="fr">Type ou catégorie d'utilisateur</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#âge">
        <rdfs:label xml:lang="fr">âge</rdfs:label>
        <rdfs:comment xml:lang="fr">Âge de l'utilisateur en années</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#téléphone">
        <rdfs:label xml:lang="fr">téléphone</rdfs:label>
        <rdfs:comment xml:lang="fr">Numéro de téléphone de l'utilisateur</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#dateInscription">
        <rdfs:label xml:lang="fr">date d'inscription</rdfs:label>
        <rdfs:comment xml:lang="fr">Date d'inscription de l'utilisateur au système</rdfs:comment>
        <rdfs:domain rdf:resource="#Utilisateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour Trajet -->
    <owl:DatatypeProperty rdf:about="#distance">
        <rdfs:label xml:lang="fr">distance</rdfs:label>
        <rdfs:comment xml:lang="fr">Distance du trajet en kilomètres</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#durée">
        <rdfs:label xml:lang="fr">durée</rdfs:label>
        <rdfs:comment xml:lang="fr">Durée du trajet en minutes</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#mode">
        <rdfs:label xml:lang="fr">mode</rdfs:label>
        <rdfs:comment xml:lang="fr">Mode de transport utilisé pour le trajet</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#pointDépart">
        <rdfs:label xml:lang="fr">point de départ</rdfs:label>
        <rdfs:comment xml:lang="fr">Adresse ou nom du point de départ du trajet</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#pointArrivée">
        <rdfs:label xml:lang="fr">point d'arrivée</rdfs:label>
        <rdfs:comment xml:lang="fr">Adresse ou nom du point d'arrivée du trajet</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#heureDebut">
        <rdfs:label xml:lang="fr">heure de début</rdfs:label>
        <rdfs:comment xml:lang="fr">Heure de début du trajet</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#coût">
        <rdfs:label xml:lang="fr">coût</rdfs:label>
        <rdfs:comment xml:lang="fr">Coût du trajet en dinars tunisiens</rdfs:comment>
        <rdfs:domain rdf:resource="#Trajet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour Véhicule, Vélo et Voiture -->
    <owl:DatatypeProperty rdf:about="#immatriculation">
        <rdfs:label xml:lang="fr">immatriculation</rdfs:label>
        <rdfs:comment xml:lang="fr">Numéro d'immatriculation du véhicule</rdfs:comment>
        <rdfs:domain rdf:resource="#Véhicule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#typeVéhicule">
        <rdfs:label xml:lang="fr">type de véhicule</rdfs:label>
        <rdfs:comment xml:lang="fr">Type ou catégorie du véhicule</rdfs:comment>
        <rdfs:domain rdf:resource="#Véhicule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#marque">
        <rdfs:label xml:lang="fr">marque</rdfs:label>
        <rdfs:comment xml:lang="fr">Marque du véhicule</rdfs:comment>
        <rdfs:domain rdf:resource="#Véhicule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#modèle">
        <rdfs:label xml:lang="fr">modèle</rdfs:label>
        <rdfs:comment xml:lang="fr">Modèle du véhicule</rdfs:comment>
        <rdfs:domain rdf:resource="#Véhicule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#couleur">
        <rdfs:label xml:lang="fr">couleur</rdfs:label>
        <rdfs:comment xml:lang="fr">Couleur du véhicule</rdfs:comment>
        <rdfs:domain rdf:resource="#Véhicule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#statut">
        <rdfs:label xml:lang="fr">statut</rdfs:label>
        <rdfs:comment xml:lang="fr">Statut du véhicule (disponible, en cours d'utilisation, en maintenance)</rdfs:comment>
        <rdfs:domain rdf:resource="#Véhicule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#niveauBatterie">
        <rdfs:label xml:lang="fr">niveau de batterie</rdfs:label>
        <rdfs:comment xml:lang="fr">Niveau de batterie pour les véhicules électriques (en pourcentage)</rdfs:comment>
        <rdfs:domain rdf:resource="#Véhicule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour Station -->
    <owl:DatatypeProperty rdf:about="#nomStation">
        <rdfs:label xml:lang="fr">nom de station</rdfs:label>
        <rdfs:comment xml:lang="fr">Nom de la station</rdfs:comment>
        <rdfs:domain rdf:resource="#Station"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#latitude">
        <rdfs:label xml:lang="fr">latitude</rdfs:label>
        <rdfs:comment xml:lang="fr">Coordonnée latitude de la station</rdfs:comment>
        <rdfs:domain rdf:resource="#Station"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#longitude">
        <rdfs:label xml:lang="fr">longitude</rdfs:label>
        <rdfs:comment xml:lang="fr">Coordonnée longitude de la station</rdfs:comment>
        <rdfs:domain rdf:resource="#Station"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#adresse">
        <rdfs:label xml:lang="fr">adresse</rdfs:label>
        <rdfs:comment xml:lang="fr">Adresse complète de la station</rdfs:comment>
        <rdfs:domain rdf:resource="#Station"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#capacité">
        <rdfs:label xml:lang="fr">capacité</rdfs:label>
        <rdfs:comment xml:lang="fr">Nombre maximum de véhicules que peut accueillir la station</rdfs:comment>
        <rdfs:domain rdf:resource="#Station"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#heuresOuverture">
        <rdfs:label xml:lang="fr">heures d'ouverture</rdfs:label>
        <rdfs:comment xml:lang="fr">Heures d'ouverture de la station</rdfs:comment>
        <rdfs:domain rdf:resource="#Station"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#typeStation">
        <rdfs:label xml:lang="fr">type de station</rdfs:label>
        <rdfs:comment xml:lang="fr">Type de station (vélos, voitures, mixte)</rdfs:comment>
        <rdfs:domain rdf:resource="#Station"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour TransportPublic -->
    <owl:DatatypeProperty rdf:about="#ligne">
        <rdfs:label xml:lang="fr">ligne</rdfs:label>
        <rdfs:comment xml:lang="fr">Numéro ou nom de la ligne de transport</rdfs:comment>
        <rdfs:domain rdf:resource="#TransportPublic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#fréquence">
        <rdfs:label xml:lang="fr">fréquence</rdfs:label>
        <rdfs:comment xml:lang="fr">Fréquence de passage en minutes</rdfs:comment>
        <rdfs:domain rdf:resource="#TransportPublic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#typeTransport">
        <rdfs:label xml:lang="fr">type de transport</rdfs:label>
        <rdfs:comment xml:lang="fr">Type de transport public (bus, métro, tramway)</rdfs:comment>
        <rdfs:domain rdf:resource="#TransportPublic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tarif">
        <rdfs:label xml:lang="fr">tarif</rdfs:label>
        <rdfs:comment xml:lang="fr">Tarif du transport en dinars tunisiens</rdfs:comment>
        <rdfs:domain rdf:resource="#TransportPublic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour Arrêt -->
    <owl:DatatypeProperty rdf:about="#nomArrêt">
        <rdfs:label xml:lang="fr">nom d'arrêt</rdfs:label>
        <rdfs:comment xml:lang="fr">Nom de l'arrêt de transport public</rdfs:comment>
        <rdfs:domain rdf:resource="#Arrêt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#latitudeArrêt">
        <rdfs:label xml:lang="fr">latitude arrêt</rdfs:label>
        <rdfs:comment xml:lang="fr">Coordonnée latitude de l'arrêt</rdfs:comment>
        <rdfs:domain rdf:resource="#Arrêt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#longitudeArrêt">
        <rdfs:label xml:lang="fr">longitude arrêt</rdfs:label>
        <rdfs:comment xml:lang="fr">Coordonnée longitude de l'arrêt</rdfs:comment>
        <rdfs:domain rdf:resource="#Arrêt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#accessibilité">
        <rdfs:label xml:lang="fr">accessibilité</rdfs:label>
        <rdfs:comment xml:lang="fr">Niveau d'accessibilité pour personnes à mobilité réduite</rdfs:comment>
        <rdfs:domain rdf:resource="#Arrêt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour PisteCyclable -->
    <owl:DatatypeProperty rdf:about="#nomPiste">
        <rdfs:label xml:lang="fr">nom de piste</rdfs:label>
        <rdfs:comment xml:lang="fr">Nom ou identifiant de la piste cyclable</rdfs:comment>
        <rdfs:domain rdf:resource="#PisteCyclable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#longueurPiste">
        <rdfs:label xml:lang="fr">longueur de piste</rdfs:label>
        <rdfs:comment xml:lang="fr">Longueur de la piste cyclable en kilomètres</rdfs:comment>
        <rdfs:domain rdf:resource="#PisteCyclable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#typePiste">
        <rdfs:label xml:lang="fr">type de piste</rdfs:label>
        <rdfs:comment xml:lang="fr">Type de piste cyclable (séparée, partagée, bande cyclable)</rdfs:comment>
        <rdfs:domain rdf:resource="#PisteCyclable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#étatPiste">
        <rdfs:label xml:lang="fr">état de piste</rdfs:label>
        <rdfs:comment xml:lang="fr">État de la piste cyclable (bon, moyen, mauvais)</rdfs:comment>
        <rdfs:domain rdf:resource="#PisteCyclable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour Réservation -->
    <owl:DatatypeProperty rdf:about="#idRéservation">
        <rdfs:label xml:lang="fr">identifiant réservation</rdfs:label>
        <rdfs:comment xml:lang="fr">Identifiant unique de la réservation</rdfs:comment>
        <rdfs:domain rdf:resource="#Réservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#dateRéservation">
        <rdfs:label xml:lang="fr">date de réservation</rdfs:label>
        <rdfs:comment xml:lang="fr">Date et heure de la réservation</rdfs:comment>
        <rdfs:domain rdf:resource="#Réservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#duréeRéservation">
        <rdfs:label xml:lang="fr">durée de réservation</rdfs:label>
        <rdfs:comment xml:lang="fr">Durée prévue de la réservation en minutes</rdfs:comment>
        <rdfs:domain rdf:resource="#Réservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#statutRéservation">
        <rdfs:label xml:lang="fr">statut de réservation</rdfs:label>
        <rdfs:comment xml:lang="fr">Statut de la réservation (active, terminée, annulée)</rdfs:comment>
        <rdfs:domain rdf:resource="#Réservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#prixRéservation">
        <rdfs:label xml:lang="fr">prix de réservation</rdfs:label>
        <rdfs:comment xml:lang="fr">Prix de la réservation en dinars tunisiens</rdfs:comment>
        <rdfs:domain rdf:resource="#Réservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- Propriétés pour Route -->
    <owl:DatatypeProperty rdf:about="#nomRoute">
        <rdfs:label xml:lang="fr">nom de route</rdfs:label>
        <rdfs:comment xml:lang="fr">Nom ou identifiant de la route</rdfs:comment>
        <rdfs:domain rdf:resource="#Route"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#distanceRoute">
        <rdfs:label xml:lang="fr">distance de route</rdfs:label>
        <rdfs:comment xml:lang="fr">Distance totale de la route en kilomètres</rdfs:comment>
        <rdfs:domain rdf:resource="#Route"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tempsEstimé">
        <rdfs:label xml:lang="fr">temps estimé</rdfs:label>
        <rdfs:comment xml:lang="fr">Temps estimé pour parcourir la route en minutes</rdfs:comment>
        <rdfs:domain rdf:resource="#Route"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#typeRoute">
        <rdfs:label xml:lang="fr">type de route</rdfs:label>
        <rdfs:comment xml:lang="fr">Type de route (urbaine, autoroute, piste cyclable)</rdfs:comment>
        <rdfs:domain rdf:resource="#Route"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Propriétés supplémentaires pour Administrateur -->
    <owl:DatatypeProperty rdf:about="#rôle">
        <rdfs:label xml:lang="fr">rôle</rdfs:label>
        <rdfs:comment xml:lang="fr">Rôle de l'administrateur dans le système</rdfs:comment>
        <rdfs:domain rdf:resource="#Administrateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#niveauAccès">
        <rdfs:label xml:lang="fr">niveau d'accès</rdfs:label>
        <rdfs:comment xml:lang="fr">Niveau d'accès de l'administrateur (1-5)</rdfs:comment>
        <rdfs:domain rdf:resource="#Administrateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>

