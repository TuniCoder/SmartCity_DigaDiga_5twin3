    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/mobility-ontology/2025/09#coût">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="fr">coût</rdfs:label>
    <rdfs:comment xml:lang="fr">Coût du trajet en dinars tunisiens</rdfs:comment>
