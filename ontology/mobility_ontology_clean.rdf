  <rdf:Description rdf:about="http://example.org/mobility-ontology/2025/09#Vélo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="fr">Vélo</rdfs:label>
    <rdfs:comment xml:lang="fr">Véhicule à deux roues actionné par pédales</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/mobility-ontology/2025/09#Véhicule"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/mobility-ontology/2025/09#modèle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
