    <rdfs:comment xml:lang="fr">Identifiant unique de la réservation</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/mobility-ontology/2025/09#Réservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/mobility-ontology/2025/09#Route">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="fr">Route</rdfs:label>
    <rdfs:comment xml:lang="fr">Itinéraire ou chemin entre deux points</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/mobility-ontology/2025/09#dateInscription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
